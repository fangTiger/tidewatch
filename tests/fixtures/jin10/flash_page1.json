":16},{"cids":[2995],"id":26},{"cids":[16236],"id":29},{"cids":[17953],"id":17952},{"cids":[17580,18375],"id":23},{"cids":[32],"id":31}],"remark":[],"tags":[],"time":"2026-09-30 10:47:09","type":0,"voice_status":"ready","voices":null},{"channel":[1],"data":{"content":"澳大利亚标普/ASX 200指数上涨1%，报8,794.50点，为自9月11日以来最高。","exclusive_to":[],"pic":"","source":"","source_link":"","title":""},"extras":{"ad":false},"id":"20260930104435856800","important":0,"kinds":[{"cids":[16336],"id":29},{"cids":[17956],"id":26},{"cids":[17958],"id":17952}],"remark":[],"tags":[],"time":"2026-09-30 10:44:35","type":0,"voice_status":"ready","voices":null},{"channel":[5],"data":{"content":"威廉姆斯称9月加息后无需急于再行动，黄金短线修复窗口打开，但反弹成色仍需今晚PCE验证；美债收益率高企难阻黄金ETF9月净流入，黄金价格中枢仍有望守住高位。","link":"https://xnews.jin10.com/details/231351","pic":"https://img.jin10.com/news/26/09/EXZSlHaTMgOFQdJTautT2.jpg/lite","source":"","source_link":"","tag":"VIP","title":"投资者购买黄金的动机已转向组合保护，结构性对冲需求支撑价格中枢"},"extras":{"ad":false},"id":"20260930104419886800","important":1,"kinds":[{"cids":[522],"id":16},{"cids":[17958],"id":17952},{"cids":[28],"id":2},{"cids":[28],"id":1},{"cids":[18369],"id":22}],"remark":[],"tags":[],"time":"2026-09-30 10:44:19","type":2,"voice_status":"not_applicable","voices":null},{"channel":[1,2,3],"data":{"content":"【凯投宏观：基础通胀保持平稳，澳洲联储不太可能进一步收紧政策】金十数据9月30日讯，凯投宏观亚太地区高级经济学家Abhijit Surya表示，由于有迹象显示澳大利亚基础通胀率不再加速上涨，澳洲联储不太可能进一步收紧货币政策。Surya表示：“8月核心通胀指标并未进一步走强，这支持了我们的观点，即澳洲联储的紧缩周期可能已经结束。”Surya指出，澳大利亚8月截尾均值通胀率和加权中位数通胀率均维持在3.6%不变。Surya补充称，澳洲联储“短期内可能仍将处于观望模式”，等待未来几个月通胀放缓趋势得到确认。","exclusive_to":[],"pic":"","source":"","source_link":"","title":""},"extras":{"ad":false},"id":"20260930104409640800","important":0,"kinds":[{"cids":[16510],"id":25},{"cids":[32],"id":31},{"cids":[17953,17958],"id":17952},{"cids":[16336],"id":29}],"remark":[],"tags":[],"time":"2026-09-30 10:44:09","type":0,"voice_status":"ready","voices":null},{"channel":[3,4,5],"data":{"content":"【8月国内游戏市场收入316.27亿元 同比增长8.08%】金十数据9月30日讯，据伽马数据月度报告，2026年8月国内游戏市场实际销售收入31